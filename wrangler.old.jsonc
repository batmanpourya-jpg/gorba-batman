{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gorba-batman",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "MESSENGER", "class_name": "Messenger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Messenger"] }
  ]
}
