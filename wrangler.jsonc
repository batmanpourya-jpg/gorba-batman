{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gorba-batman",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MESSENGER",
        "class_name": "Messenger"
      }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Messenger": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ChatRoomV2": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
